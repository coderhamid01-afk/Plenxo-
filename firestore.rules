rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication check
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User profile ownership check
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // 1. User Profiles (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      // Authenticated users can fetch a specific user profile document by ID
      allow get: if isAuthenticated();
      // Restrict collection enumeration: queries must specify limit <= 5 for exact Plenxo ID lookup
      allow list: if isAuthenticated() && request.query.limit <= 5;
      // Users can only create and modify their own profile
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User subcollections (active_sessions, call_history, blocked, etc.)
      match /call_history/{callId} {
        allow read, write: if isOwner(userId);
      }
      match /active_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // 2. Parallel User Data (/users_data/{userId})
    // ===============================================================
    match /users_data/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // 3. User Presence (/presence/{userId} & /users_presence/{userId})
    // ===============================================================
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /users_presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // 4. Friend Requests (/friend_requests/{requestId})
    // ===============================================================
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.requestFrom == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        resource.data.requestFrom == request.auth.uid ||
        resource.data.requestTo == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // ===============================================================
    // 5. Chat Requests (/chat_requests/{requestId})
    // ===============================================================
    match /chat_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.requestFrom == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        resource.data.requestFrom == request.auth.uid ||
        resource.data.requestTo == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
    }

    // ===============================================================
    // 6. Direct Messages (/messages/{messageId} & /message/{messageId})
    // ===============================================================
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.from == request.auth.uid ||
        !('senderId' in request.resource.data)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }

    match /message/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.from == request.auth.uid ||
        !('senderId' in request.resource.data)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
    }

    // ===============================================================
    // 7. Chats and Subcollections (/chats/{chatId})
    // ===============================================================
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===============================================================
    // 8. Contacts & Relationships
    // ===============================================================
    match /contacts/{contactId} {
      allow read, write: if isAuthenticated();
    }

    match /friends/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /blocked_users/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /blocked_list/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // 9. WebRTC Calls Signaling (/calls/{callId})
    // ===============================================================
    match /calls/{callId} {
      allow read, write: if isAuthenticated();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /call_logs/{callLogId} {
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // 10. Status / Stories (/status/{statusId})
    // ===============================================================
    match /status/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    // ===============================================================
    // 11. Security, Sessions & Audit History
    // ===============================================================
    match /active_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    match /security_keys/{keyId} {
      allow read, write: if isAuthenticated();
    }

    match /archived_keys/{keyId} {
      allow read, write: if isAuthenticated();
    }

    match /name_history/{historyId} {
      allow read, write: if isAuthenticated();
    }

    match /bio_history/{historyId} {
      allow read, write: if isAuthenticated();
    }

    match /avatar_history/{historyId} {
      allow read, write: if isAuthenticated();
    }

    match /profile_shares/{shareId} {
      allow read, write: if isAuthenticated();
    }

    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    // ===============================================================
    // 12. System Metadata & Bootstrap (/ _meta/{docId})
    // ===============================================================
    match /_meta/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /app_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin managed
    }
  }
}
